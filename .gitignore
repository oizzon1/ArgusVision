########################################
# Model weights and checkpoints (HEAVY)
########################################
*.pt
*.pth
*.h5
*.ckpt
*.onnx

########################################
# Datasets / heavy raw data
########################################
# Anchored to repo root — unanchored patterns here once swallowed source dirs
# (src/datasets/ was never tracked; src/argusvision/data/ nearly suffered the same)
/data/
/datasets/
/AerialFuseCV/
/raw_data/
/ContextOnProject/

# Keep placeholder files to preserve folder structure
!data/.gitkeep
!datasets/.gitkeep
!AerialFuseCV/.gitkeep
!raw_data/.gitkeep
!**/.gitkeep

########################################
# Results / logs / experiment outputs
########################################
# Ignore everything in results/, but keep directories traversable so the
# metrics/manifest allowlist below actually works for NEW files (with the old
# `results/*` form, git never descended into fresh run directories).
results/**
!results/**/

# Keep final metrics JSON files + run provenance
!results/**/metrics_summary.json
!results/**/evaluation_metrics.json
!results/**/*_metrics.json
!results/**/metrics.json
!results/**/manifest.json
# Evidence artefacts that papers cite. Every published number must live in
# git next to the manifest that produced it, so these are re-included by name.
# Suffix patterns, not bare names — `!results/**/manifest.json` does NOT match
# `build_manifest.json`, which silently excluded it (same class of defect as
# finding F8, where unanchored patterns dropped src/datasets from git).
!results/**/*manifest.json
!results/**/*_audit.json
!results/**/dataset_statistics.json
# Sources for numbers that appear in paper prose. The rule is that no
# experimental number is written unless it exists in results/ — which is
# hollow if results/ lives only on one machine. AerialFuseCV_v1 was deleted
# while the draft still cited divergence numbers measured from it, leaving
# Tables 5-6 with no surviving source. Small artefacts only; the bulk
# (per_pair.jsonl at 24 MB, the figure PNGs) stays out.
!results/**/figure_values.json
!results/**/discrepancy_summary.json
!results/**/deposit_verification.json
!results/**/*_report.json
# The raw human judgements behind the alignment audit. Without these the
# reported rate cannot be recomputed or challenged, which is the whole point of
# publishing an audit rather than asserting one.
!results/**/alignment_audit_results.json
!results/**/sample_manifest.json

# The staged Zenodo package is a build artefact -- 82 MB, and every file in it
# is either copied from the deposit or generated by make_zenodo_package.py, so
# tracking it would duplicate content git already holds or can regenerate.
# package_manifest.json is the durable record: it carries the inventory, sizes
# and SHA-256 of every file actually deposited.
zenodo_release/AerialFuseCV_v*/
!zenodo_release/package_manifest.json
# Reports and findings are the prose that interprets the metrics beside them.
# They were previously tracked only because individual files had been
# force-added, which meant a new report silently stayed out of git.
!results/**/*.md
# Anything a run needs kept beyond metrics — env freezes, probe output, loss
# logs — goes in an `evidence/` folder and is tracked whatever its extension.
# One convention instead of a growing list of per-filename exceptions.
# Keep it small: bulk regenerable payloads stay outside it.
!results/**/evidence/**

# Ignore huge restore points specifically
results/**/restore_points/

# Keep .gitkeep files for structure
!results/.gitkeep
!results/**/.gitkeep

# Other experiment outputs
logs/
runs/
checkpoints/
wandb/
!logs/.gitkeep
!runs/.gitkeep
!checkpoints/.gitkeep
!wandb/.gitkeep

########################################
# Large imagery / geospatial (HEAVY)
########################################
*.tif
*.tiff
*.jp2
*.img
*.SAFE/
*.zip
*.7z
*.png
*.jpg
*.jpeg

# Allow small documentation / logo assets
!assets/**

########################################
# Dataset folder - ignore everything except docs
########################################
# Ignore all dataset contents (images, labels, masks)
dataset/*

# BUT keep documentation and config files
!dataset/.gitkeep
!dataset/**/.gitkeep
!dataset/**/*.md
!dataset/**/*.yaml
!dataset/**/*.yml
!dataset/**/*.txt
!dataset/**/*.json
!dataset/**/*.py
!dataset/**/*.sh
!dataset/**/*.pdf

# Specifically ignore heavy data folders even if matched above
dataset/**/images/
dataset/**/labels/
dataset/**/semantic_masks/
dataset/**/masks/
dataset/**/train/
dataset/**/val/
dataset/**/test/
dataset/iSAID/
dataset/DOTA_v1/
dataset/AerialFuseCV/
dataset/AerialFuseCV_Refined/
dataset/AerialFuseCV_Refined_Merged/
dataset/DOTA_v1_YOLO_oriented_bboxes_dataset/
dataset/DOTA_v1_YOLO_vertical_bboxes_dataset/

########################################
# Python / build artifacts
########################################
__pycache__/
*.egg-info/
*.pyc
*.pyo
*.pyd

########################################
# Jupyter noise (but ALLOW notebooks)
########################################
.ipynb_checkpoints/

# (If you REALLY want to ignore notebooks, uncomment:)
*.ipynb

########################################
# Editor / OS crap
########################################
.vscode/
.idea/
.DS_Store

########################################
# Generated document exports (binary)
########################################
# Per DECIDED: everything text-based in git; DOCX/PDF are human-facing mirrors
# (Drive), regenerable from the markdown source with pandoc.
papers/**/exports/

# Session worktrees
/.worktrees/

# Deposit artefacts — regenerated by papers/**/deposit/make_deposit.py.
# Scripts, README and LICENSE are tracked; the generated payload is not.
papers/**/deposit/correspondence.jsonl
papers/**/deposit/discarded.jsonl
papers/**/deposit/dataset_statistics.json
papers/**/deposit/checksums.sha256
papers/**/deposit/deposit_manifest.json
