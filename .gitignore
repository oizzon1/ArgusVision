########################################
# Model weights and checkpoints (HEAVY)
########################################
*.pt
*.pth
*.h5
*.ckpt
*.onnx

########################################
# Datasets / heavy raw data
########################################
/data/
/datasets/
AerialFuseCV/
raw_data/
ContextOnProject/

# Keep placeholder files to preserve folder structure
!/data/.gitkeep
!/datasets/.gitkeep
!AerialFuseCV/.gitkeep
!raw_data/.gitkeep
!**/.gitkeep

########################################
# Results / logs / experiment outputs
########################################
# Ignore everything in results/
results/*

# BUT keep final metrics JSON files
!results/**/metrics_summary.json
!results/**/evaluation_metrics.json
!results/**/*_metrics.json

# Ignore huge restore points specifically
results/**/restore_points/

# Keep .gitkeep files for structure
!results/.gitkeep
!results/**/.gitkeep

# Other experiment outputs
logs/
runs/
checkpoints/
wandb/
!logs/.gitkeep
!runs/.gitkeep
!checkpoints/.gitkeep
!wandb/.gitkeep

########################################
# Large imagery / geospatial (HEAVY)
########################################
*.tif
*.tiff
*.jp2
*.img
*.SAFE/
*.zip
*.7z
*.png
*.jpg
*.jpeg

# Allow small documentation / logo assets
!assets/**

########################################
# Dataset folder - ignore everything except docs
########################################
# Ignore all dataset contents (images, labels, masks)
dataset/*

# BUT keep documentation and config files
!dataset/.gitkeep
!dataset/**/.gitkeep
!dataset/**/*.md
!dataset/**/*.yaml
!dataset/**/*.yml
!dataset/**/*.txt
!dataset/**/*.json
!dataset/**/*.py
!dataset/**/*.pdf

# Specifically ignore heavy data folders even if matched above
dataset/**/images/
dataset/**/labels/
dataset/**/semantic_masks/
dataset/**/masks/
dataset/**/train/
dataset/**/val/
dataset/**/test/
dataset/iSAID/
dataset/DOTA_v1/
dataset/AerialFuseCV/
dataset/AerialFuseCV_Refined/
dataset/AerialFuseCV_Refined_Merged/
dataset/DOTA_v1_YOLO_oriented_bboxes_dataset/
dataset/DOTA_v1_YOLO_vertical_bboxes_dataset/

########################################
# Python / build artifacts
########################################
__pycache__/
*.pyc
*.pyo
*.pyd

########################################
# Jupyter noise (but ALLOW notebooks)
########################################
.ipynb_checkpoints/

# (If you REALLY want to ignore notebooks, uncomment:)
*.ipynb

########################################
# Editor / OS crap
########################################
.vscode/
.idea/
.DS_Store
